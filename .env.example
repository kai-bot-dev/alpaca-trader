# Alpaca API credentials
# Get these from https://app.alpaca.markets (paper trading keys)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# API base URL - use paper trading by default
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database path (optional, defaults to ./alpaca_trader.db)
DATABASE_URL=./alpaca_trader.db

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8080
